{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "DevPreviewApp",
            "request": "launch",
            "mainClass": "com.wateradvisory.Charlie_Root.DevPreviewApp",
            "projectName": "WaterAdvisoryProject"
        },
        {
            "type": "java",
            "name": "DevPreviewLauncher",
            "request": "launch",
            "mainClass": "com.wateradvisory.Charlie_Root.DevPreviewLauncher",
            "projectName": "WaterAdvisoryProject"
        },
        {
            "type": "java",
            "name": "Launch App via Launcher",
            "request": "launch",
            "mainClass": "com.wateradvisory.Launcher",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "projectName": "WaterAdvisoryProject"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "com.wateradvisory.Main",
            "projectName": "WaterAdvisoryProject"
        }
    ]
}