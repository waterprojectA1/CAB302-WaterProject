<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wateradvisory.Charlie_Root.ChatController">

    <top>
        <VBox fx:id="headerBox" styleClass="chat-page-header">

            <VBox spacing="10">
                <padding>
                    <Insets top="16" right="18" bottom="12" left="18"/>
                </padding>
                <Button text="&#8592; Back" styleClass="btn,btn-ghost" onAction="#onBack"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="chat-avatar" maxWidth="40" maxHeight="40" minWidth="40" minHeight="40">
                        <Label text="&#128167;" style="-fx-font-size: 17px;"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="Rippl" styleClass="chat-title"/>
                        <Label text="your water conservation assistant" styleClass="text-muted"
                               style="-fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- wave divider: path data is regenerated in ChatController to match headerBox's actual width -->
            <SVGPath fx:id="waveDivider" content="M0,14 L420,14 L420,28 L0,28 Z" fill="#e9f3fc"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true" styleClass="chat-scroll">
            <VBox fx:id="conversationContainer" styleClass="chat-container" spacing="14"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="chat-input-bar">
            <HBox styleClass="chat-input-pill" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                <TextField fx:id="inputField" styleClass="chat-input-field" promptText="Ask something..."
                           onAction="#onSend" HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendButton" text="&#10148;" styleClass="btn-icon-send" onAction="#onSend"/>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
