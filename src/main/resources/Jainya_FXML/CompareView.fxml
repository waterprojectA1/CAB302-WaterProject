<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wateradvisory.Jainya_Root.Controllers.CompareController"
      styleClass="card" spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <GridPane hgap="8" vgap="8">
        <Label text="Period 1:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="p1Start" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <DatePicker fx:id="p1End" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <Label text="Period 2:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="p2Start" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <DatePicker fx:id="p2End" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
    </GridPane>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Compare" onAction="#onCompare" styleClass="primary-button"/>
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
    </HBox>

    <HBox spacing="18" alignment="CENTER" styleClass="compare-summary">
        <VBox alignment="CENTER" spacing="4">
            <Label text="PERIOD 1 AVG / DAY" styleClass="plabel"/>
            <Label fx:id="p1Value" text="–" styleClass="pvalue"/>
        </VBox>
        <Label text="&#8594;" styleClass="arrow"/>
        <VBox alignment="CENTER" spacing="4">
            <Label text="PERIOD 2 AVG / DAY" styleClass="plabel"/>
            <Label fx:id="p2Value" text="–" styleClass="pvalue"/>
            <Label fx:id="changeBadge" styleClass="change-badge"/>
        </VBox>
    </HBox>

    <Label fx:id="insightLabel" wrapText="true" styleClass="insight-box" maxWidth="Infinity"/>
</VBox>