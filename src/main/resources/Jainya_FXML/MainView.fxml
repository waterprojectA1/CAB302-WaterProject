<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wateradvisory.Jainya_Root.Controllers.MainController"
            stylesheets="@../css/style1.css, @app-extras.css"
            styleClass="main-background">
    <top>
        <Label text="Water Usage — Trends &amp; Seasonal Patterns" styleClass="page-title" BorderPane.alignment="CENTER" maxWidth="Infinity"/>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Daily">
                    <fx:include source="DailyView.fxml"/>
                </Tab>
                <Tab text="Seasonal">
                    <fx:include source="SeasonalView.fxml"/>
                </Tab>
                <Tab text="Compare">
                    <fx:include source="CompareView.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>