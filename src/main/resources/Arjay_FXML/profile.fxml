<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="516.0" prefWidth="882.0" styleClass="root"
            stylesheets="@../Charlie_FXML/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wateradvisory.Arjay_Root.Profile">

    <AnchorPane fx:id="mainProfile" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <VBox spacing="16.0" styleClass="page"
              AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

            <Label styleClass="page-title" text="User profile" />

            <HBox styleClass="stat-strip" spacing="18.0" alignment="CENTER_LEFT">
                <Label fx:id="profileAvatarLabel" styleClass="avatar-circle, avatar-tint, avatar-xl" text="U" />
                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                    <Text fx:id="usernameText" styleClass="section-title" text="Username: NULL" />
                    <Text fx:id="emailText" styleClass="page-subtitle" text="Email: NULL" />
                </VBox>
                <Button fx:id="viewHouseholdFromProfileBtn" mnemonicParsing="false"
                        onAction="#handleViewHousehold" styleClass="btn, btn-secondary"
                        text="View household &#8594;" />
            </HBox>

            <Label styleClass="section-title" text="Water summary" />

            <HBox spacing="12.0">
                <VBox styleClass="metric-card" spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="DAILY" />
                    <Text fx:id="dailyTotalText" styleClass="metric-value" text="Daily Total" />
                </VBox>
                <VBox styleClass="metric-card" spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="THIS WEEK" />
                    <Text fx:id="weeklyTotalText" styleClass="metric-value" text="Weekly Total" />
                </VBox>
                <VBox styleClass="metric-card" spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="ALL TIME" />
                    <Text fx:id="allTimeTotalText" styleClass="metric-value" text="All Time Total" />
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox>
                <Button fx:id="goBackBtn" mnemonicParsing="false" onAction="#handleReturnToMain"
                        styleClass="btn, btn-secondary" text="Back to home" />
            </HBox>
        </VBox>
    </AnchorPane>
</AnchorPane>
