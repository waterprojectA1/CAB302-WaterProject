<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="516.0" prefWidth="882.0" styleClass="root"
           stylesheets="@../Charlie_FXML/app.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.wateradvisory.Arjay_Root.Login">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>

    <VBox styleClass="auth-card" spacing="12.0" maxHeight="-Infinity" maxWidth="400.0">

        <VBox spacing="2.0">
            <Label styleClass="page-title" text="Water Advisory" />
            <Label styleClass="page-subtitle" text="Sign in to keep tracking your water" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="Email" />
            <TextField fx:id="emailField" promptText="you@example.com" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="form-label" text="Password" />
            <StackPane>
                <PasswordField fx:id="passwordField" promptText="Password" />
                <TextField fx:id="visiblePasswordField" promptText="Password" />
            </StackPane>
        </VBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <ToggleButton fx:id="showPasswordBtn" mnemonicParsing="false"
                          onAction="#handleShowPassword" styleClass="toggle-btn"
                          text="Show password" />
            <ComboBox fx:id="recentLoginBox" promptText="Recent logins"
                      prefWidth="150.0" HBox.hgrow="ALWAYS" />
        </HBox>

        <Button mnemonicParsing="false" onAction="#handleLogin"
                styleClass="btn, btn-primary, btn-block" text="Login" />
        <Button fx:id="signupBtn" mnemonicParsing="false" onAction="#handleSignUp"
                styleClass="btn, btn-secondary, btn-block" text="Sign up" />
        <Button mnemonicParsing="false" onAction="#handleChatViewNavigation"
                styleClass="btn, btn-ghost" text="Open chat window" />
    </VBox>
</StackPane>
