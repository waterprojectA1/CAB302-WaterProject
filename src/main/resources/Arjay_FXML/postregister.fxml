            <Button fx:id="noHouseholdBtn" layoutX="298.0" layoutY="271.0" mnemonicParsing="false" onAction="#handleNoHousehold" prefHeight="40.0" prefWidth="287.0" styleClass="secondary-button" stylesheets="@../css/style1.css" text="No, Skip Household Creation" />
         </children>
      </AnchorPane>
      <AnchorPane fx:id="postRegister2" prefHeight="516.0" prefWidth="882.0">
