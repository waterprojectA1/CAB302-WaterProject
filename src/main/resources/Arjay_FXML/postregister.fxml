<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane prefHeight="516.0" prefWidth="882.0" styleClass="root"
           stylesheets="@../Charlie_FXML/app.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.wateradvisory.Arjay_Root.PostRegister">

    <AnchorPane fx:id="postRegister1" visible="false">
        <StackPane AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>
            <VBox styleClass="auth-card" spacing="12.0" maxHeight="-Infinity" maxWidth="420.0">
                <Text fx:id="postRegisterText" styleClass="page-title"
                      text="Would you like to create a household?" />
                <Label styleClass="page-subtitle" wrapText="true"
                       text="Households let everyone under one roof share a water total and appear on the same leaderboard." />
                <Button fx:id="yesHouseholdBtn" mnemonicParsing="false"
                        onAction="#handleYesHousehold" styleClass="btn, btn-primary, btn-block"
                        text="Yes, I live with other tenants" />
                <Button fx:id="noHouseholdBtn" mnemonicParsing="false"
                        onAction="#handleNoHousehold" styleClass="btn, btn-secondary, btn-block"
                        text="No, skip household creation" />
            </VBox>
        </StackPane>
    </AnchorPane>

    <AnchorPane fx:id="postRegister2">
        <StackPane AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>
            <VBox styleClass="auth-card" spacing="12.0" maxHeight="-Infinity" maxWidth="400.0">
                <Label styleClass="page-title" text="Your household" />
                <Label styleClass="page-subtitle" text="Enter household details to continue" />
                <VBox spacing="4.0">
                    <Label styleClass="form-label" text="Household name" />
                    <TextField fx:id="householdNameField" promptText="e.g. Kelvin Grove house" />
                </VBox>
                <VBox spacing="4.0">
                    <Label styleClass="form-label" text="Address (optional)" />
                    <TextField fx:id="addressField" promptText="Street address" />
                </VBox>
                <Button fx:id="createHouseholdBtn" mnemonicParsing="false"
                        onAction="#handleCreateHousehold" styleClass="btn, btn-primary, btn-block"
                        text="Create household" />
                <Button fx:id="returnHouseholdBtn" mnemonicParsing="false"
                        onAction="#handleReturnHousehold" styleClass="btn, btn-ghost"
                        text="Return, I changed my mind" />
            </VBox>
        </StackPane>
    </AnchorPane>
</StackPane>
