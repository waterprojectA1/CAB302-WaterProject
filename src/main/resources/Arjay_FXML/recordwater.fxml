<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="516.0" prefWidth="882.0" styleClass="root"
            stylesheets="@../Charlie_FXML/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wateradvisory.Arjay_Root.RecordWaterController">

    <!-- Today's report -->
    <AnchorPane fx:id="mainRecord" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <VBox spacing="14.0" styleClass="page"
              AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

            <Label styleClass="page-title" text="Record water consumption" />

            <VBox styleClass="metric-card" spacing="4.0" maxWidth="Infinity">
                <Label styleClass="metric-label" text="REPORTED TODAY" />
                <Text fx:id="pendingTotalText" styleClass="metric-value"
                      text="Total Water Consumption Reported: NaN" />
            </VBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label styleClass="section-title" text="Reported water usage (today)" />
                <Label fx:id="todayDateLabel" styleClass="page-subtitle" text="" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="activityBtn" mnemonicParsing="false" onAction="#handleActivityBtn"
                        styleClass="btn, btn-primary" text="Add an activity" />
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="member-scroll-pane" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="activityListBox" styleClass="member-list-box" spacing="8.0" />
                </content>
            </ScrollPane>

            <HBox spacing="10.0">
                <Button fx:id="submitWaterBtn" mnemonicParsing="false"
                        onAction="#handleSubmitWaterConsumption" styleClass="btn, btn-primary"
                        text="Submit and update today's report" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="returnToMainBtn2" mnemonicParsing="false" onAction="#handleReturnToMain"
                        styleClass="btn, btn-secondary" text="Back to home" />
            </HBox>
        </VBox>
    </AnchorPane>

    <!-- Single activity entry -->
    <AnchorPane fx:id="activityRecord" visible="false"
                AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <VBox spacing="14.0" styleClass="page"
              AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

            <Label styleClass="page-title" text="Record water usage" />

            <VBox styleClass="card" spacing="14.0" maxWidth="560.0">
                <VBox spacing="4.0">
                    <Label styleClass="form-label" text="Activity" />
                    <MenuButton fx:id="selectActivity" mnemonicParsing="false"
                                maxWidth="Infinity" text="Choose activity" />
                </VBox>

                <HBox spacing="12.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Text fx:id="activityDurationText" styleClass="form-label" text="Activity duration" />
                        <MenuButton fx:id="activityDuration" mnemonicParsing="false"
                                    maxWidth="Infinity" text="Duration" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="form-label" text="How many times?" />
                        <MenuButton fx:id="activityAmount" mnemonicParsing="false"
                                    maxWidth="Infinity" text="Select amount" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox styleClass="metric-card" spacing="4.0" maxWidth="560.0">
                <Label styleClass="metric-label" text="THIS ACTIVITY" />
                <Text fx:id="activityTotalText" styleClass="metric-value"
                      text="Water Consumption Total: NaN" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="10.0">
                <Button fx:id="activitySubmit" mnemonicParsing="false" onAction="#handleSubmitActivity"
                        styleClass="btn, btn-primary" text="Submit activity" />
                <Button fx:id="returnRecordMainBtn" mnemonicParsing="false"
                        onAction="#handleReturnToRecordMain" styleClass="btn, btn-secondary"
                        text="Back" />
            </HBox>
        </VBox>
    </AnchorPane>
</AnchorPane>
