<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="516.0" prefWidth="882.0" styleClass="root"
            stylesheets="@../Charlie_FXML/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wateradvisory.Arjay_Root.ViewHousehold">

    <!-- 1. Household overview -->
    <AnchorPane fx:id="viewHouseholdPane" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <VBox spacing="14.0" styleClass="page"
              AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

            <VBox spacing="2.0">
                <Text fx:id="householdText" styleClass="page-title" text="Household Name" />
                <Text fx:id="ownerText" styleClass="page-subtitle" text="Owner" />
            </VBox>

            <HBox spacing="12.0">
                <VBox styleClass="metric-card" spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="HOUSEHOLD WATER TOTAL" />
                    <Text fx:id="householdWaterTotalText" styleClass="metric-value" text="Water Total: NaN" />
                </VBox>
                <VBox styleClass="metric-card" spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="MEMBERS" />
                    <Text fx:id="householdTotalText" styleClass="metric-value" text="Total Members:" />
                </VBox>
                <VBox styleClass="metric-card" spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="metric-label" text="JOIN CODE" />
                    <Text fx:id="joinCodeText" styleClass="metric-value" text="Join Code:" />
                </VBox>
            </HBox>

            <Label styleClass="section-title" text="Members" />

            <ScrollPane fx:id="memberScrollPane" fitToWidth="true" styleClass="member-scroll-pane"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="memberListBox" styleClass="member-list-box" spacing="8.0" />
                </content>
            </ScrollPane>

            <HBox spacing="10.0">
                <Button fx:id="houseSettingsBtn" mnemonicParsing="false" onAction="#handleHouseSettings"
                        styleClass="btn, btn-primary" text="Edit settings" />
                <Button fx:id="returnToMainBtn1" mnemonicParsing="false" onAction="#handleReturnToMain"
                        styleClass="btn, btn-secondary" text="Back to home" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="leaveHouseholdBtn" mnemonicParsing="false" onAction="#handleLeaveHousehold"
                        styleClass="btn, btn-danger" text="Leave household" />
            </HBox>
        </VBox>
    </AnchorPane>

    <!-- 2. Household settings -->
    <AnchorPane fx:id="houseSettings" visible="false"
                AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <VBox spacing="14.0" styleClass="page"
              AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

            <Label styleClass="page-title" text="Household settings" />

            <VBox spacing="4.0" maxWidth="400.0">
                <Label styleClass="form-label" text="New household name" />
                <TextField fx:id="householdNameField" promptText="Household name" />
            </VBox>

            <Label styleClass="section-title" text="Remove members" />

            <ScrollPane fx:id="memberScrollPane1" fitToWidth="true" styleClass="member-scroll-pane"
                        maxWidth="400.0" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="editMemberListBox" styleClass="member-list-box" spacing="8.0" />
                </content>
            </ScrollPane>

            <HBox spacing="10.0">
                <Button fx:id="applyChangesBtn" mnemonicParsing="false" onAction="#handleApplyChanges"
                        styleClass="btn, btn-primary" text="Apply changes" />
                <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#handleCancelSettings"
                        styleClass="btn, btn-secondary" text="Cancel" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="deleteHouseholdBtn" mnemonicParsing="false" onAction="#handleDeleteHousehold"
                        styleClass="btn, btn-danger" text="Delete household" />
            </HBox>
        </VBox>
    </AnchorPane>

    <!-- 3. No household yet -->
    <AnchorPane fx:id="noHouseholdPane" visible="false"
                AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <StackPane AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0" />
            </padding>

            <HBox spacing="16.0" alignment="CENTER" maxHeight="-Infinity">

                <VBox styleClass="card" spacing="10.0" prefWidth="300.0">
                    <Label styleClass="section-title" text="Join a household" />
                    <Label styleClass="form-label" text="Enter the join code you were given" />
                    <TextField fx:id="joinCodeTextField" promptText="Join code" />
                    <Button fx:id="joinHouseholdBtn" mnemonicParsing="false"
                            onAction="#handleJoinHousehold"
                            styleClass="btn, btn-primary, btn-block" text="Join household" />
                </VBox>

                <Label styleClass="section-title" text="or" />

                <VBox styleClass="card" spacing="10.0" prefWidth="300.0">
                    <Label styleClass="section-title" text="Create your own" />
                    <VBox spacing="4.0">
                        <Label styleClass="form-label" text="Household name" />
                        <TextField fx:id="createHouseholdNameField" promptText="Household name" />
                    </VBox>
                    <VBox spacing="4.0">
                        <Label styleClass="form-label" text="Address (optional)" />
                        <TextField fx:id="createAddressField" promptText="Street address" />
                    </VBox>
                    <Button fx:id="createHouseholdBtn" mnemonicParsing="false"
                            onAction="#handleCreateHousehold"
                            styleClass="btn, btn-primary, btn-block" text="Create household" />
                </VBox>
            </HBox>
        </StackPane>

        <Button fx:id="returnToMainBtn" mnemonicParsing="false" onAction="#handleReturnToMain"
                styleClass="btn, btn-secondary" text="Back to home"
                AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="24.0" />
    </AnchorPane>
</AnchorPane>
