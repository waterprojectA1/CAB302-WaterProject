<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="516.0" prefWidth="882.0" spacing="14.0" styleClass="root, page"
      stylesheets="@../Charlie_FXML/app.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wateradvisory.Michael_Root.NotificationController">

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Notifications" />
        <Label fx:id="notificationCount" styleClass="page-subtitle" text="0 notifications" />
    </VBox>

    <ListView fx:id="notificationList" styleClass="notif-list" VBox.vgrow="ALWAYS" />

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#handleReturnToMain"
                styleClass="btn, btn-secondary" text="Back to home" />
        <Button mnemonicParsing="false" onAction="#handleGoToGraph"
                styleClass="btn, btn-secondary" text="Graphs" />
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#handleReturnTable"
                styleClass="btn, btn-primary" text="Water records" />
    </HBox>
</VBox>
