<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="516.0" prefWidth="882.0" spacing="14.0" styleClass="root, page"
      stylesheets="@../Charlie_FXML/app.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wateradvisory.Michael_Root.TablePageController">

    <HBox spacing="12.0" alignment="CENTER_LEFT">
        <Label styleClass="page-title" text="Water records" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox styleClass="seg-track" spacing="2.0">
            <ToggleButton fx:id="dailyRadio" text="Daily" styleClass="seg-toggle" />
            <ToggleButton fx:id="weeklyRadio" text="Weekly" styleClass="seg-toggle" />
            <ToggleButton fx:id="monthlyRadio" text="Monthly" styleClass="seg-toggle" />
        </HBox>
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="userIDColumn" text="User" />
            <TableColumn fx:id="dateColumn" text="Date">
                <columns>
                    <TableColumn fx:id="sDateColumn" text="Start" />
                    <TableColumn fx:id="eDateColumn" text="End" />
                </columns>
            </TableColumn>
            <TableColumn fx:id="usageColumn" text="Water use" />
            <TableColumn fx:id="zScoreColumn" text="Z score" />
            <TableColumn fx:id="userDiffColumn" text="vs your average" />
            <TableColumn fx:id="globalDiffColumn" text="vs all households" />
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#handleReturnToMain"
                styleClass="btn, btn-secondary" text="Back to home" />
        <Button mnemonicParsing="false" onAction="#handleGoToGraph"
                styleClass="btn, btn-secondary" text="Graphs" />
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#handleGoToNotification"
                styleClass="btn, btn-primary" text="Notifications" />
    </HBox>
</VBox>
