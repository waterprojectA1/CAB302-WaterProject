<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="400.0" styleClass="root" stylesheets="@../Charlie_FXML/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wateradvisory.Michael_Root.TablePageController">
    <HBox alignment="CENTER" spacing="20">

        <RadioButton fx:id="dailyRadio" styleClass="btn-ghost" text="Daily" textFill="WHITE" />

        <RadioButton fx:id="weeklyRadio" styleClass="btn-ghost" text="Weekly" textFill="WHITE" />

        <RadioButton fx:id="monthlyRadio" styleClass="btn-ghost" text="Monthly" textFill="WHITE" />

    </HBox>

    <TableView fx:id="tableView" prefHeight="200.0" prefWidth="400.0">
        <columns>
            <TableColumn fx:id="userIDColumn" text="User" />
            <TableColumn fx:id="dateColumn" text="Date">
                <columns>
                    <TableColumn fx:id="sDateColumn" text="Start Date" />
                    <TableColumn fx:id="eDateColumn" text="End Date" />
                </columns>
            </TableColumn>
            <TableColumn fx:id="usageColumn" text="Water Use" />
            <TableColumn fx:id="zScoreColumn" text="Zscore" />
            <TableColumn fx:id="userDiffColumn" text="User Difference" />
            <TableColumn fx:id="globalDiffColumn" text="Global Difference" />

        </columns>
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </TableView>
   <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
      <children>
         <Button mnemonicParsing="false" onAction="#handleReturnToMain" styleClass="btn" text="Back">
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
         </Button>
         <Button mnemonicParsing="false" onAction="#handleGoToGraph" styleClass="btn" text="Graph" >
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
         </Button>
         <Button mnemonicParsing="false" onAction="#handleGoToNotification" styleClass="btn" text="Notification">
            <HBox.margin>
               <Insets left="5.0" right="5.0" />
            </HBox.margin>
         </Button>
      </children>
   </HBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>

</VBox>
