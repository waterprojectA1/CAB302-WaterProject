<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="516.0" prefWidth="882.0" spacing="14.0" styleClass="root, page, leaderboard-page"
      stylesheets="@../Charlie_FXML/app.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wateradvisory.Steve_Root.LeaderboardController">

    <Label styleClass="page-title" text="Leaderboards" />

    <HBox spacing="14.0" VBox.vgrow="ALWAYS">

        <VBox styleClass="leaderboard-card" spacing="10.0" HBox.hgrow="ALWAYS">
            <Label maxWidth="Infinity" styleClass="card-title" text="Household" />
            <Label fx:id="seasonLabel" maxWidth="Infinity" styleClass="season-label"
                   text="Current season" />
            <Label fx:id="messageLabel" maxWidth="Infinity" styleClass="message-label"
                   text="Loading leaderboard..." wrapText="true" />
            <ScrollPane fitToWidth="true" styleClass="leaderboard-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="leaderboardList" spacing="10.0" styleClass="leaderboard-list" />
                </content>
            </ScrollPane>
        </VBox>

        <VBox alignment="CENTER" spacing="12.0" prefWidth="180.0" maxHeight="-Infinity"
              styleClass="profile-card">
            <Label fx:id="profileSymbolLabel" styleClass="profile-symbol" text="U" />
            <Label styleClass="form-label" text="Your seasonal points" wrapText="true" />
            <Label fx:id="currentPointsLabel" styleClass="current-points-label" text="0 PTS" />
        </VBox>
    </HBox>

    <HBox>
        <Button mnemonicParsing="false" onAction="#handleGoHome"
                styleClass="btn, btn-secondary" text="Back to home" />
    </HBox>
</VBox>
